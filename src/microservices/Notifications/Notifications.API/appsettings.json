{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "NotificationsDb": "",
    "message-bus": ""
  },
  "EmailProvider": "Smtp",
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "TaskTracker <noreply@tasktracker.local>"
  },
  "Resend": {
    "ApiToken": "",
    "From": ""
  },
  "Frontend": {
    "EmailConfirmationPageAddress": ""
  },
  "AllowedHosts": "*",
  "CorsOptions": {
    "Name": "",
    "AllowedOrigins": [],
    "AllowedMethods": [],
    "AllowedHeaders": []
  }
}