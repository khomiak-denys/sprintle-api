{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "NotificationsDb": "",
    "message-bus": ""
  },
  "AllowedHosts": "*",
  "CorsOptions": {
    "Name": "",
    "AllowedOrigins": [],
    "AllowedMethods": [],
    "AllowedHeaders": []
  }
}