# =============================================================================
# Sprintle API - Environment Variables & Secrets Configuration
# =============================================================================
# Copy this file to .env and adjust the values for your environment:
#   cp .env.example .env
#
# Note: The .env file is excluded from version control via .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# General Application Settings
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# RabbitMQ (Message Bus)
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# PostgreSQL Databases
# -----------------------------------------------------------------------------
# Users Database
USERS_DB_USER=postgres
USERS_DB_PASSWORD=postgres
USERS_DB_NAME=UsersDb
USERS_DB_PORT=5432

# Notifications Database
NOTIFICATIONS_DB_USER=postgres
NOTIFICATIONS_DB_PASSWORD=postgres
NOTIFICATIONS_DB_NAME=NotificationsDb
NOTIFICATIONS_DB_PORT=5433

# Workspaces Database
WORKSPACES_DB_USER=postgres
WORKSPACES_DB_PASSWORD=postgres
WORKSPACES_DB_NAME=WorkspacesDb
WORKSPACES_DB_PORT=5434

# -----------------------------------------------------------------------------
# Microservice Host Published Ports
# -----------------------------------------------------------------------------
USERS_SERVICE_PORT=10000
USERS_SERVICE_HTTPS_PORT=10001

NOTIFICATIONS_SERVICE_PORT=10002
NOTIFICATIONS_SERVICE_HTTPS_PORT=10003

WORKSPACES_SERVICE_PORT=10004
WORKSPACES_SERVICE_HTTPS_PORT=10005

GATEWAY_PORT=10006
GATEWAY_HTTPS_PORT=10007

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Key must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_KEY=super_secret_jwt_key_that_is_at_least_32_characters_long_12345!
JWT_ISSUER=Sprintle
JWT_AUDIENCE=SprintleClient
JWT_TOKEN_VALIDITY_MINS=60

# -----------------------------------------------------------------------------
# Internal Service Integration
# -----------------------------------------------------------------------------
# API key used for internal service-to-service communication
INTEGRATION_API_KEY=dev-integration-api-key-super-secret

# Internal service URLs within the Docker network
USERS_SERVICE_INTERNAL_URL=http://Users-Service:8080
WORKSPACES_SERVICE_INTERNAL_URL=http://Workspaces-Service:8080

# -----------------------------------------------------------------------------
# Email & Notifications (Resend)
# -----------------------------------------------------------------------------
RESEND_API_TOKEN=re_your_resend_api_token_here
RESEND_FROM=Sprintle <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Frontend URLs & CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
FRONTEND_CONFIRM_EMAIL_URL=http://localhost:4200/confirm-email
FRONTEND_DASHBOARD_URL=http://localhost:4200/dashboard

CORS_POLICY_NAME=AllowFrontend
CORS_ALLOWED_ORIGIN=http://localhost:4200
