    {
      "name": "01. Auth",
      "description": "Authentication endpoints for user registration, login, token refresh, and token revocation.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (!json.token && json.accessToken) {",
                  "    json.token = json.accessToken;",
                  "}",
                  "",
                  "if (json.token) {",
                  "    pm.collectionVariables.set(\"access_token\", json.token);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set(\"access_token\", json.token);",
                  "    }",
                  "    console.log(\"Token saved:\", json.token);",
                  "} else {",
                  "    console.error(\"Token NOT FOUND in response\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"userName\": \"johndoe\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{usersBaseUrl}}/api/v1/auth/register",
              "host": [
                "{{usersBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user and returns an access token, setting the refresh token in an HTTP-only cookie."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (!json.token && json.accessToken) {",
                  "    json.token = json.accessToken;",
                  "}",
                  "",
                  "if (json.token) {",
                  "    pm.collectionVariables.set(\"access_token\", json.token);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set(\"access_token\", json.token);",
                  "    }",
                  "    console.log(\"Token saved:\", json.token);",
                  "} else {",
                  "    console.error(\"Token NOT FOUND in response\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{usersBaseUrl}}/api/v1/auth/login",
              "host": [
                "{{usersBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates a user and saves the access token to collection variables via test script."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "if (!json.token && json.accessToken) {",
                  "    json.token = json.accessToken;",
                  "}",
                  "",
                  "if (json.token) {",
                  "    pm.collectionVariables.set(\"access_token\", json.token);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set(\"access_token\", json.token);",
                  "    }",
                  "    console.log(\"Token saved:\", json.token);",
                  "} else {",
                  "    console.error(\"Token NOT FOUND in response\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{usersBaseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{usersBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Refreshes an expired access token using the refreshToken HTTP-only cookie and the previous access token."
          },
          "response": []
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{usersBaseUrl}}/api/v1/auth/revoke",
