        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    try {",
                  "        const body = pm.response.text();",
                  "        const taskId = body.replace(/\"/g, \"\").trim();",
                  "        if (taskId) {",
                  "            pm.collectionVariables.set(\"taskId\", taskId);",
                  "            if (pm.environment && pm.environment.name) {",
                  "                pm.environment.set(\"taskId\", taskId);",
                  "            }",
                  "            console.log(\"New taskId saved:\", taskId);",
                  "        }",
                  "    } catch (e) {",
                  "        console.error(\"Could not parse created taskId\", e);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement User Authentication Flow\",\n  \"description\": \"Configure JWT tokens, refresh tokens, and authentication cookies\",\n  \"priority\": \"High\",\n  \"deadline\": \"2026-10-15T18:00:00.000Z\",\n  \"assigneeId\": \"{{userId}}\",\n  \"tags\": [\n    \"backend\",\n    \"auth\",\n    \"security\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
