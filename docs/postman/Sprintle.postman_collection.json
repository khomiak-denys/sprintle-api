          "name": "Create Workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    try {",
                  "        const body = pm.response.text();",
                  "        const workspaceId = body.replace(/\"/g, \"\").trim();",
                  "        if (workspaceId) {",
                  "            pm.collectionVariables.set(\"workspaceId\", workspaceId);",
                  "            if (pm.environment && pm.environment.name) {",
                  "                pm.environment.set(\"workspaceId\", workspaceId);",
                  "            }",
                  "            console.log(\"New workspaceId saved:\", workspaceId);",
                  "        }",
                  "    } catch (e) {",
                  "        console.error(\"Could not parse created workspaceId\", e);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
